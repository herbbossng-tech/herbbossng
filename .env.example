# Copy this file to .env.local (already gitignored) and fill in real values.
# Never commit .env.local or any file containing real secrets.

# Supabase project settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Cloud OAuth 2.0 Client ID (Web application type) — needed only
# for the Google Sheets order source (0053). A client ID is not secret;
# only the client SECRET is (that lives server-side as the Supabase
# function secret GOOGLE_OAUTH_CLIENT_SECRET, never here). Register
# https://<project-ref>.supabase.co/functions/v1/google-oauth-callback
# as an Authorized redirect URI on this OAuth Client.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Optional: only needed by scripts/edge functions, never by client code.
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
