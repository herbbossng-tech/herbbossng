# Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/herbbossng?schema=public"

# Auth.js
AUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Used to encrypt SMTP passwords / Meta access tokens at rest (32-byte base64 key)
ENCRYPTION_KEY="replace-with-openssl-rand-base64-32"

# Base URL used in emails / OG tags / server-to-server links
APP_URL="http://localhost:3000"
